# Frontend env — Vite.
#
# ⚠️ Vite only reads files named EXACTLY:  .env · .env.local · .env.[mode] · .env.[mode].local
#    A file called `env.production` (no leading dot) is silently ignored. That missing dot is
#    what produced the "Firebase configuration" error in a fresh checkout.
#
#   copy -> vpnexues-ui/.env.local      local dev  (every mode: dev server + build)
#   copy -> vpnexues-ui/.env.production production build only (wins over .env.local)
#
# Both are git-ignored. Never commit the filled-in files — this example carries names only.

# Backend base URL.
#   local dev  : leave EMPTY — an empty value keeps requests on the Vite proxy
#                (/api -> http://localhost:8080, see vite.config.ts). The backend must be
#                running (`.\gradlew.bat bootRun`) or every call fails.
#   production : https://vpnexues-api.onrender.com
#                NOTE the Render free tier cold-starts 60-100 s — a first load against it can
#                look like a "server busy" error. Run the backend locally for development.
VITE_API_BASE_URL=

VITE_APP_ENV=development

# Firebase web config — read by src/config/firebase.ts.
# These are NOT secrets: web API keys ship in the public JS bundle by design. But if they are
# missing the app logs "[Firebase] No VITE_FIREBASE_API_KEY found - Firebase disabled." and
# phone-OTP login stops working, which is what the "firebase configuration" report was.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_DEMO_MODE=false
VITE_MEDIA_BASE_URL=
